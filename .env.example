# Local development: a SQLite file in the project root.
DATABASE_URL=file:./dev.db

# Hosted (Turso). Both are needed; DATABASE_AUTH_TOKEN is ignored for file: URLs.
# Seeding a hosted database is gated: `npm run db:seed -- --force`. Without the
# flag it skips, so that a build cannot wipe production on every deploy.
# DATABASE_URL=libsql://<database>-<org>.turso.io
# DATABASE_AUTH_TOKEN=

# AI provider is still undecided, see AGENTS.md open items.
# AI_PROVIDER=
